{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human corpus canonical passage record v2.7",
  "type": "object",
  "required": [
    "schema_version", "chunk_id", "document_id", "group_id", "chunk_index",
    "split", "subset", "label", "provenance_status", "institution_id",
    "sentence_ids", "document_char_spans", "approx_tokens", "text"
  ],
  "properties": {
    "schema_version": {"const": "human-training-v2.7"},
    "chunk_id": {"type": "string", "pattern": "^chunk_"},
    "document_id": {"type": "string", "pattern": "^doc_"},
    "group_id": {"type": "string", "minLength": 1},
    "chunk_index": {"type": "integer", "minimum": 0},
    "split": {"enum": ["train", "dev", "test", "excluded"]},
    "subset": {"enum": ["core_human", "recent_or_uncertain", "excluded"]},
    "label": {"const": "H"},
    "provenance_status": {"enum": ["high_confidence_human", "transitional_2022", "recent_provenance_uncertain", "unknown_year"]},
    "institution_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unit_type": {"type": "string"},
    "unit_types": {"type": "array", "items": {"type": "string"}},
    "normalization_status": {"enum": ["active", "review_required"]},
    "review_flags": {"type": "array", "items": {"type": "string"}},
    "source_spans": {"type": "array", "items": {"type": "object", "required": ["page_index", "source_start", "source_end"], "properties": {"page_index": {"type": "integer", "minimum": 0}, "source_start": {"type": "integer", "minimum": 0}, "source_end": {"type": "integer", "minimum": 0}, "text": {"type": "string"}}}},
    "duplicate_of": {"type": ["string", "null"]},
    "page_start": {"type": "integer", "minimum": 0},
    "page_end": {"type": "integer", "minimum": 0},
    "start_char": {"type": "integer", "minimum": 0},
    "end_char": {"type": "integer", "minimum": 1},
    "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document_char_spans": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false}
    },
    "approx_tokens": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"subset": {"const": "core_human"}}, "required": ["subset"]},
      "then": {
        "properties": {
          "provenance_status": {"const": "high_confidence_human"},
          "split": {"enum": ["train", "dev", "test"]},
          "approx_tokens": {"minimum": 1, "maximum": 512}
        }
      }
    }
  ],
  "additionalProperties": true
}
