{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentence-preserving model window",
  "type": "object",
  "required": ["window_id", "document_id", "group_id", "split", "section_id", "token_count", "max_tokens", "sentence_ids", "sentence_token_spans", "context_mask", "loss_mask", "labels", "text"],
  "properties": {
    "window_id": {"type": "string", "pattern": "^win_"},
    "split": {"enum": ["train", "dev", "test"]},
    "token_count": {"type": "integer", "minimum": 1},
    "max_tokens": {"type": "integer", "minimum": 8},
    "sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "context_mask": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
    "loss_mask": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
    "labels": {"type": "array", "minItems": 1, "items": {"enum": ["H", "P", "G"]}},
    "text": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
