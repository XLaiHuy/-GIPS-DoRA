{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-human-v1.0/source-file",
  "title": "Audited source PDF",
  "type": "object",
  "required": ["source_file_id", "relative_path", "sha256", "bytes", "page_count", "release_outcome", "release_reason"],
  "properties": {
    "source_file_id": {"type": "string", "minLength": 1},
    "document_id": {"type": ["string", "null"]},
    "relative_path": {"type": "string", "pattern": "^[^/\\\\]+\\.pdf$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "release_outcome": {"enum": ["accepted", "excluded", "quarantine", "duplicate", "failed"]},
    "release_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
