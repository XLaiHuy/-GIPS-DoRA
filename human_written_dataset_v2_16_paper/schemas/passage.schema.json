{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-human-v1.0/passage",
  "title": "Canonical non-overlapping Human passage",
  "type": "object",
  "required": ["passage_id", "document_id", "source_file_id", "group_id", "split", "chunk_index", "sentence_ids", "page_start_index", "page_end_index", "document_char_start", "document_char_end", "text", "text_sha256", "fingerprint_sha256", "approx_tokens", "label"],
  "properties": {
    "passage_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "source_file_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test"]},
    "chunk_index": {"type": "integer", "minimum": 0},
    "sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "page_start_index": {"type": "integer", "minimum": 0},
    "page_end_index": {"type": "integer", "minimum": 0},
    "document_char_start": {"type": "integer", "minimum": 0},
    "document_char_end": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approx_tokens": {"type": "integer", "minimum": 1, "maximum": 512},
    "label": {"const": "H"}
  },
  "additionalProperties": true
}
