{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-human-v1.0/paragraph",
  "title": "Canonical paragraph",
  "type": "object",
  "required": ["paragraph_id", "document_id", "source_file_id", "sentence_ids", "document_char_start", "document_char_end", "text", "text_sha256"],
  "properties": {
    "paragraph_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "source_file_id": {"type": "string", "minLength": 1},
    "sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "document_char_start": {"type": "integer", "minimum": 0},
    "document_char_end": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
