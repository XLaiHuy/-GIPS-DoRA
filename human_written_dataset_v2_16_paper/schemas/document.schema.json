{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-human-v1.0/document",
  "title": "Canonical Human document",
  "type": "object",
  "required": ["document_id", "source_file_id", "group_id", "split", "title", "authors", "year", "institution_id", "document_type_id", "language_detected", "text", "document_text_sha256"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "source_file_id": {"type": "string", "minLength": 1},
    "metadata_record_id": {"type": ["string", "null"]},
    "group_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test"]},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "year": {"type": "integer", "maximum": 2022},
    "institution_id": {"type": "string", "minLength": 1},
    "document_type_id": {"enum": ["bachelor_thesis", "capstone_project", "master_thesis", "doctoral_dissertation"]},
    "language_detected": {"enum": ["vi", "en", "mixed"]},
    "text": {"type": "string", "minLength": 5000},
    "document_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
